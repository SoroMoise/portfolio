# ---------------------------------------------------------------------------
# Canonical origin.
#
# Defaults to https://codeurdivoire.com, so you only need this for preview
# deployments or a local tunnel. Setting it wrong points every canonical tag,
# hreflang alternate and OG image at the wrong host.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://codeurdivoire.com

# ---------------------------------------------------------------------------
# Contact form delivery — pick ONE of the two blocks below.
#
# With neither configured the endpoint returns 502 and the form shows an error.
# That is deliberate: a contact form that silently drops messages is worse than
# one that admits it is not wired up.
# ---------------------------------------------------------------------------

# --- Option 1: your own mailbox over SMTP (no third-party service) ---------
#
# Messages are sent straight from your mailbox and land in your inbox. Nobody
# else sees them, and there is nothing new to sign up for.
#
# For Gmail you need an App Password, not your normal password:
#   1. Google Account -> Security -> turn on two-step verification
#   2. Google Account -> Security -> App passwords -> create one
#   3. Paste the 16 characters below, spaces removed
#
# Port 465 uses implicit TLS; use 587 if your provider wants STARTTLS.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=soromoise4@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx

# --- Option 2: Resend, if you would rather not store a mailbox password ----
#
# Sign up at https://resend.com, then API Keys -> Create API Key (sending
# permission is enough). The free tier covers a contact form comfortably.
# Until you verify a domain, keep CONTACT_FROM on the shared sandbox sender.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM=Codeur d'Ivoire <contact@codeurdivoire.com>

# --- Applies to both options -----------------------------------------------
#
# Where enquiries are delivered. Defaults to the address in lib/content/site.ts.
# CONTACT_EMAIL=soromoise4@gmail.com
