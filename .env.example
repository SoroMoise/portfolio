# ---------------------------------------------------------------------------
# Canonical origin. Set this to the production domain so canonical URLs,
# hreflang alternates, the sitemap and the OG images all point at the right
# host. Defaults to https://soromoise.vercel.app when unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://codeurdivoire.com

# ---------------------------------------------------------------------------
# Contact form delivery (Resend — https://resend.com).
#
# Without RESEND_API_KEY the endpoint returns 502 and the form shows an error,
# on purpose: a contact form that silently drops messages is worse than one
# that admits it is not wired up.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. Defaults to the address in lib/content/site.ts.
CONTACT_EMAIL=soromoise4@gmail.com

# Verified sender. Until a domain is verified in Resend, the shared sandbox
# sender below works for testing.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
