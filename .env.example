# ---------------------------------------------------------------------------
# Canonical origin (build time).
#
# Defaults to https://codeurdivoire.com, so you only need this for a local
# tunnel. Setting it wrong points every canonical tag, hreflang alternate and
# OG image at the wrong host.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://codeurdivoire.com

# ---------------------------------------------------------------------------
# Contact form (Worker variables, set in wrangler.jsonc "vars" or the dashboard).
#
# Mail goes out through the Worker's Cloudflare Email Sending binding (EMAIL);
# there is no password or API key to set.
# ---------------------------------------------------------------------------
# CONTACT_FROM=portfolio@mail.codeurdivoire.com
# CONTACT_EMAIL=soromoise4@gmail.com
